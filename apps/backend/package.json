{
  "name": "@flowforge/backend",
  "version": "0.2.1",
  "description": "Backend server for FlowForge browser extension",
  "private": true,
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean:dist": "rm -rf dist/",
    "clean:data": "rm -rf data/",
    "clean": "npm run clean:dist && npm run clean:data",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "node scripts/quick-setup.js",
    "build": "npm run clean:dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "concurrently \"tsc -p tsconfig.json --watch\" \"tsc-alias -p tsconfig.json --watch\""
  },
  "keywords": [
    "ai",
    "browser",
    "navigation",
    "onboarding",
    "rag",
    "agents",
    "user-flows",
    "user-experience"
  ],
  "dependencies": {
    "@flowforge/contract": "*",
    "@flowforge/page-trail": "*",
    "@lancedb/lancedb": "^0.39.0",
    "@langchain/core": "^1.2.14",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.6.2",
    "@langchain/textsplitters": "^1.0.2",
    "boxen": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "langchain": "^1.5.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsc-alias": "^1.9.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
