{
  "name": "@flowforge/extension",
  "version": "0.2.1",
  "description": "Browser extension for AI-powered web application onboarding",
  "private": true,
  "main": "dist/chrome/action/popup/index.html",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:embed": "vite build --config vite.config.embed.ts && cp src/embed/flowforge-runtime.d.ts dist/embed/flowforge-runtime.d.ts",
    "build": "npm run clean && npm run typecheck && npm run build:chrome && npm run build:embed",
    "install:chrome": "node scripts/install-chrome.js",
    "dev:chrome": "vite build --config vite.config.chrome.ts --watch",
    "dev:embed": "vite build --config vite.config.embed.ts --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "concurrently \"npm run dev:chrome\" \"npm run dev:embed\"",
    "sandbox": "node sandbox/server.js"
  },
  "keywords": [
    "ai",
    "browser",
    "navigation",
    "onboarding",
    "rag",
    "agents",
    "user-flows",
    "user-experience"
  ],
  "dependencies": {
    "@flowforge/contract": "*",
    "@flowforge/page-trail": "*",
    "lucide-preact": "^1.31.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/chrome": "^0.1.38",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "express": "^5.2.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "marked": "^18.0.2",
    "preact": "^10.29.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.11"
  }
}
